<Project>
  <!--
    Every application and library in the monorepo lives under the CINE root namespace
    (LaunchHeim.Core -> CINE.LaunchHeim.Core), see decision 0004 in the second brain. Each app sets it in
    its own Directory.Build.props so it stays self-contained, the same way GroceryTracker does.
    Assembly and project names keep no prefix.
  -->
  <PropertyGroup>
    <RootNamespace>CINE.$(MSBuildProjectName)</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      The release version, for every project: Core reports it (Settings → About, the User-Agent) and
      Desktop's assembly carries it. It used to sit in the Desktop csproj only, so Core fell back to
      1.0.0. The launchheim-v* tag must match it, and CHANGELOG.md needs a section for it.
    -->
    <Version>0.4.0</Version>
    <!--
      The Android companion's versionCode for this version: major * 10000 + minor * 100 + patch. It's
      written out because F-Droid finds new releases by reading it from this file with a regex and can't
      work it out from <Version>. android/app/build.gradle.kts refuses to build when the two disagree.
    -->
    <AndroidVersionCode>400</AndroidVersionCode>
  </PropertyGroup>

  <!--
    Distribution packages build reproducibly, which also maps the source paths recorded in the assemblies
    to /_/. Without it the build folder ends up in the package (makepkg warns about $srcdir).
  -->
  <PropertyGroup Condition="'$(LaunchHeimDistroPackage)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
