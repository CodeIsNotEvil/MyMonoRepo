<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The instant-start plugin (src/InstantStart) compiles against BepInEx and Unity, which are only on
    BepInEx's own feed. Source mapping keeps every other package on nuget.org, so that feed can't
    stand in for one of them.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bepinex">
      <package pattern="BepInEx.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
  </packageSourceMapping>
</configuration>
