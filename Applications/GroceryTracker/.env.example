# Copy to .env next to docker-compose.yml and change the password before the first start.
# .env is ignored by git; .env.example is not.

POSTGRES_DB=grocerytracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Host port nginx is published on. The app is then at http://<pi-hostname>:8080
WEB_PORT=8080

# HTTPS port, used only once a certificate exists in deploy/certs (see deploy/https.md).
# 443 works where the container engine may bind privileged ports — rootful Docker, or rootless
# Podman with net.ipv4.ip_unprivileged_port_start lowered.
WEB_TLS_PORT=8443
