@page "/import"
@using System.Text
@using GroceryTracker.Domain.Import
@inject GroceryDataService Data
@inject NavigationManager Nav

<PageTitle>Import · Grocery Tracker</PageTitle>

<h1>Import bookings</h1>

<section class="card">
    <p class="text-sm" style="margin-top:0;">
        Import a CSV export of your spending sheet. Only <strong>dates</strong> and <strong>amounts</strong>
        are read: every filled amount cell becomes one trip. You then say <strong>which person each
        amount column belongs to</strong>, so the balance between people is right. Bookings are saved
        under the category you pick, at a store called <em>Imported</em>.
    </p>

    <label for="csv">CSV file</label>
    <InputFile id="csv" OnChange="OnFileChosenAsync" accept=".csv,.txt,text/csv" disabled="@_busy" />

    <p class="text-sm muted mb-0 mt-1">
        Importing the same file again is safe: bookings already here are not duplicated (a re-import
        with people chosen assigns them to bookings that had none), and ones you deleted stay deleted.
    </p>
</section>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_result is { } result)
{
    <div class="alert alert-info">
        @ResultText(result)
        Changes are saved on this device and upload to the server on the next sync.
    </div>

    <div class="btn-row">
        <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("balance"))">See the balance</button>
        <button class="btn btn-ghost" @onclick="@(() => Nav.NavigateTo(""))">Dashboard</button>
        <button class="btn btn-ghost" @onclick="@(() => Nav.NavigateTo("trips"))">Trips</button>
    </div>
}
else if (_parsed is not null && _plan is not null)
{
    <section class="card">
        <div class="card-header"><h2>Who paid?</h2></div>
        <p class="text-sm muted">
            Each column of amounts belongs to one person. Pick who, or add them as a new person.
        </p>

        @foreach (var choice in _choices)
        {
            <div class="field" style="border-top:1px solid var(--border); padding-top:.75rem;">
                <div style="display:flex; justify-content:space-between; gap:.5rem; align-items:baseline;">
                    <label for="col-@choice.Column.Index" style="margin:0; color:var(--text-primary);">
                        Column “@choice.Column.Header”
                    </label>
                    <span class="text-sm muted nowrap">
                        @choice.Column.BookingCount booking@(choice.Column.BookingCount == 1 ? "" : "s") · @Money.Format(choice.Column.Total, Currency)
                    </span>
                </div>

                <select id="col-@choice.Column.Index" class="mt-1" value="@choice.Selection"
                        @onchange="e => OnSelectionChangedAsync(choice, e)">
                    <option value="">Nobody (leave unassigned)</option>
                    @foreach (var member in _members)
                    {
                        <option value="@($"m:{member.Id}")">@member.DisplayName</option>
                    }
                    <option value="new">New person…</option>
                </select>

                @if (choice.Selection == NewPerson)
                {
                    <input class="mt-1" placeholder="Name" aria-label="@($"Name of the new person for column {choice.Column.Header}")"
                           value="@choice.NewName" @onchange="e => OnNameChangedAsync(choice, e)" maxlength="120" />

                    @if (string.IsNullOrWhiteSpace(choice.NewName))
                    {
                        <div class="validation-message">Enter a name.</div>
                    }
                }
            </div>
        }
    </section>

    <section class="card">
        <div class="field mb-0">
            <label for="category">Category for the new bookings</label>
            <select id="category" value="@(_categoryId?.ToString() ?? string.Empty)" @onchange="OnCategoryChangedAsync">
                <option value="">No category</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
    </section>

    <div class="tiles">
        <div class="tile">
            <div class="tile-label">Found</div>
            <div class="tile-value">@_parsed.Bookings.Count</div>
            <div class="tile-note">@Money.Format(_parsed.Bookings.Sum(b => b.Amount), Currency) in @_fileName</div>
        </div>
        <div class="tile">
            <div class="tile-label">New</div>
            <div class="tile-value">@_plan.NewTrips.Count</div>
            <div class="tile-note">@NewRange</div>
        </div>
        <div class="tile">
            <div class="tile-label">Assign person</div>
            <div class="tile-value">@_plan.PayerUpdates.Count</div>
            <div class="tile-note">already here, no payer yet</div>
        </div>
        <div class="tile">
            <div class="tile-label">Unchanged</div>
            <div class="tile-value">@_plan.AlreadyImported</div>
            <div class="tile-note">will be skipped</div>
        </div>
    </div>

    @if (_plan.NewMembers.Count > 0)
    {
        <div class="alert alert-info">
            Adds @(_plan.NewMembers.Count == 1 ? "this person" : "these people"):
            <strong>@string.Join(", ", _plan.NewMembers.Select(m => m.DisplayName))</strong>.
        </div>
    }

    @if (_parsed.DateOutliers.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>@_parsed.DateOutliers.Count date@(_parsed.DateOutliers.Count == 1 ? " looks" : "s look") wrong.</strong>
            @(_parsed.DateOutliers.Count == 1 ? "It sits" : "They sit") far from every other booking,
            which is usually a typo (2015 instead of 2025).
            <ul style="margin:.4rem 0 .4rem 1.1rem; padding:0;">
                @foreach (var outlier in _parsed.DateOutliers)
                {
                    <li>Line @outlier.SourceLine: @outlier.Date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) · @Money.Format(outlier.Amount, Currency)</li>
                }
            </ul>
            Best fixed in the sheet <em>before</em> importing: a corrected row would come in as a
            new booking and leave the wrong one behind. You can still edit the trip afterwards.
        </div>
    }

    @if (NegativeCount > 0)
    {
        <div class="alert alert-info">
            @NegativeCount booking@(NegativeCount == 1 ? " is" : "s are") negative (a refund or a
            correction). @(NegativeCount == 1 ? "It" : "They") will lower @(NegativeCount == 1 ? "that person's" : "their") paid amount.
        </div>
    }

    @if (_parsed.Skipped.Count > 0)
    {
        <section class="card">
            <div class="card-header">
                <h2>Skipped rows</h2>
                <span class="spacer badge badge-warning">@_parsed.Skipped.Count</span>
            </div>
            <p class="text-sm muted">These rows had no usable date or amount, so nothing was imported from them.</p>
            <table class="data">
                <thead>
                    <tr><th scope="col">Line</th><th scope="col">Why</th><th scope="col">Row</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _parsed.Skipped.Take(MaxSkippedShown))
                    {
                        <tr>
                            <td>@row.Line</td>
                            <td>@row.Reason</td>
                            <td class="muted">@row.Raw</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_parsed.Skipped.Count > MaxSkippedShown)
            {
                <p class="text-sm muted mt-1 mb-0">…and @(_parsed.Skipped.Count - MaxSkippedShown) more.</p>
            }
        </section>
    }

    @if (!_plan.HasChanges)
    {
        <div class="alert alert-info">Nothing to change: everything in this file is already here.</div>
    }
    else
    {
        <div class="btn-row">
            <button class="btn btn-primary" @onclick="ImportAsync" disabled="@(_busy || HasInvalidChoice)">
                @ImportButtonLabel
            </button>
        </div>
    }
}
else if (_noHousehold)
{
    <div class="alert alert-info">
        This device has not synced yet. Connect to your server once, then you can import.
    </div>
}

@code {
  private const int MaxFileBytes = 5 * 1024 * 1024;
  private const int MaxSkippedShown = 10;
  private const string NewPerson = "new";

  private sealed class ColumnChoice
  {
    public required CsvAmountColumn Column { get; init; }

    /// <summary>"" for nobody, "new" for a new person, or "m:&lt;id&gt;" for an existing one.</summary>
    public string Selection { get; set; } = string.Empty;

    public string NewName { get; set; } = string.Empty;
  }

  private CsvParseResult? _parsed;
  private ImportPlan? _plan;
  private List<ColumnChoice> _choices = [];
  private List<Member> _members = [];
  private List<Category> _categories = [];
  private Guid? _categoryId;
  private string _fileName = string.Empty;
  private string? _error;
  private bool _busy;
  private bool _noHousehold;
  private ImportResult? _result;

  private string Currency => _plan?.Household.CurrencyCode ?? "EUR";

  private int NegativeCount => _parsed?.Bookings.Count(b => b.Amount < 0m) ?? 0;

  private bool HasInvalidChoice =>
    _choices.Any(c => c.Selection == NewPerson && string.IsNullOrWhiteSpace(c.NewName));

  private string NewRange => _plan is { NewTrips.Count: > 0 }
    ? $"{_plan.NewTrips.Min(t => t.PurchasedOn):MMM yyyy} – {_plan.NewTrips.Max(t => t.PurchasedOn):MMM yyyy}"
    : "nothing new";

  private string ImportButtonLabel => _plan switch
  {
    { NewTrips.Count: > 0, PayerUpdates.Count: > 0 } =>
      $"Import {_plan.NewTrips.Count} new, assign {_plan.PayerUpdates.Count}",
    { NewTrips.Count: > 0 } =>
      $"Import {_plan.NewTrips.Count} booking{(_plan.NewTrips.Count == 1 ? "" : "s")}",
    { PayerUpdates.Count: > 0 } =>
      $"Assign people to {_plan.PayerUpdates.Count} booking{(_plan.PayerUpdates.Count == 1 ? "" : "s")}",
    _ => "Add people",
  };

  private static string ResultText(ImportResult result)
  {
    var parts = new List<string>();

    if (result.NewTrips > 0)
    {
      parts.Add($"imported {result.NewTrips} new booking{(result.NewTrips == 1 ? "" : "s")}");
    }

    if (result.UpdatedTrips > 0)
    {
      parts.Add($"assigned a person to {result.UpdatedTrips} existing booking{(result.UpdatedTrips == 1 ? "" : "s")}");
    }

    if (result.NewMembers > 0)
    {
      parts.Add($"added {result.NewMembers} {(result.NewMembers == 1 ? "person" : "people")}");
    }

    var text = string.Join(", ", parts);
    return char.ToUpperInvariant(text[0]) + text[1..] + ".";
  }

  private async Task OnFileChosenAsync(InputFileChangeEventArgs e)
  {
    _parsed = null;
    _plan = null;
    _choices = [];
    _error = null;
    _noHousehold = false;
    _result = null;
    _busy = true;

    try
    {
      var file = e.File;
      _fileName = file.Name;

      await using var stream = file.OpenReadStream(MaxFileBytes);
      using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
      var text = await reader.ReadToEndAsync();

      var parsed = GroceryCsvParser.Parse(text);

      if (parsed.Bookings.Count == 0)
      {
        _error = parsed.Skipped.Count > 0
          ? "No bookings could be read from this file. Each row needs a date (like 04.04.2024) and an amount (like 81,50 €)."
          : "This file is empty.";
        return;
      }

      if (await Data.GetHouseholdAsync() is null)
      {
        _noHousehold = true;
        return;
      }

      _members = await Data.GetMembersAsync();
      _categories = await Data.GetCategoriesAsync();
      _categoryId = (await Data.GetDefaultCategoryAsync())?.Id;
      _choices = parsed.Columns.Select(DefaultChoice).ToList();
      _parsed = parsed;

      await RebuildPlanAsync();
    }
    catch (IOException)
    {
      _error = $"That file is larger than {MaxFileBytes / (1024 * 1024)} MB, which is far more than a spending sheet needs.";
    }
    catch (Exception ex)
    {
      _error = $"Could not read that file: {ex.Message}";
    }
    finally
    {
      _busy = false;
    }
  }

  /// <summary>
  /// A column headed with someone's name is assumed to be that person: an existing one if the name
  /// matches, otherwise a new one. A column with no usable header starts out unassigned.
  /// </summary>
  private ColumnChoice DefaultChoice(CsvAmountColumn column)
  {
    var choice = new ColumnChoice { Column = column };

    if (column.Header.StartsWith("Column ", StringComparison.Ordinal))
    {
      return choice;
    }

    var match = _members.FirstOrDefault(m =>
      string.Equals(m.DisplayName, column.Header, StringComparison.CurrentCultureIgnoreCase));

    if (match is not null)
    {
      choice.Selection = $"m:{match.Id}";
    }
    else
    {
      choice.Selection = NewPerson;
      choice.NewName = column.Header;
    }

    return choice;
  }

  private async Task OnSelectionChangedAsync(ColumnChoice choice, ChangeEventArgs e)
  {
    choice.Selection = e.Value?.ToString() ?? string.Empty;

    if (choice.Selection == NewPerson && string.IsNullOrWhiteSpace(choice.NewName)
      && !choice.Column.Header.StartsWith("Column ", StringComparison.Ordinal))
    {
      choice.NewName = choice.Column.Header;
    }

    await RebuildPlanAsync();
  }

  private async Task OnCategoryChangedAsync(ChangeEventArgs e)
  {
    _categoryId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    await RebuildPlanAsync();
  }

  private async Task OnNameChangedAsync(ColumnChoice choice, ChangeEventArgs e)
  {
    choice.NewName = e.Value?.ToString() ?? string.Empty;
    await RebuildPlanAsync();
  }

  private async Task RebuildPlanAsync()
  {
    if (_parsed is null)
    {
      return;
    }

    _plan = await Data.PlanImportAsync(_parsed.Bookings, _choices.Select(ToAssignment).ToList(), _categoryId);
  }

  private static ColumnAssignment ToAssignment(ColumnChoice choice)
  {
    if (choice.Selection.StartsWith("m:", StringComparison.Ordinal)
      && Guid.TryParse(choice.Selection.AsSpan(2), out var memberId))
    {
      return new ColumnAssignment(choice.Column.Index, memberId, null);
    }

    return choice.Selection == NewPerson
      ? new ColumnAssignment(choice.Column.Index, null, choice.NewName)
      : new ColumnAssignment(choice.Column.Index, null, null);
  }

  private async Task ImportAsync()
  {
    if (_plan is null)
    {
      return;
    }

    _busy = true;
    _error = null;

    try
    {
      _result = await Data.ImportAsync(_plan);
      _parsed = null;
      _plan = null;
      _choices = [];
    }
    catch (Exception ex)
    {
      _error = $"The import failed: {ex.Message}";
    }
    finally
    {
      _busy = false;
    }
  }
}
