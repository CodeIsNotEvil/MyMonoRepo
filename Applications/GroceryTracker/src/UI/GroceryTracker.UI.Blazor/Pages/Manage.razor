@page "/manage"
@inject GroceryDataService Data

<PageTitle>Manage · Grocery Tracker</PageTitle>

<h1>Manage</h1>

<section class="card">
    <div class="card-header"><h2>Import</h2></div>
    <p class="text-sm muted">Bring in past bookings from a CSV export of your spending sheet.</p>
    <a class="btn btn-ghost" href="import">Import bookings from CSV</a>
</section>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_household is null)
{
    <div class="alert alert-info">
        This device has not synced yet. Connect to your server once to set things up.
    </div>
}
else
{
    <section class="card">
        <div class="card-header"><h2>Stores</h2></div>

        <ul class="list">
            @foreach (var store in _stores)
            {
                <li class="list-row">
                    <input class="grow" value="@store.Name" @onchange="e => RenameStoreAsync(store, e.Value?.ToString())" />
                    <button class="btn btn-sm btn-danger" title="Remove store"
                            @onclick="() => DeleteStoreAsync(store)">Remove</button>
                </li>
            }
        </ul>

        <div class="field-row mt-2">
            <input @bind="_newStore" @bind:event="oninput" placeholder="New store" />
            <button class="btn btn-primary" style="flex:0 0 auto;"
                    disabled="@string.IsNullOrWhiteSpace(_newStore)" @onclick="AddStoreAsync">Add</button>
        </div>
    </section>

    <section class="card">
        <div class="card-header"><h2>Categories</h2></div>

        <ul class="list">
            @foreach (var category in _categories)
            {
                <li class="list-row">
                    <span class="swatch" style="background:@category.ColorHex" aria-hidden="true"></span>
                    <input class="grow" value="@category.Name" @onchange="e => RenameCategoryAsync(category, e.Value?.ToString())" />
                    <input type="color" value="@category.ColorHex" style="width:48px; padding:2px;"
                           aria-label="@($"Colour for {category.Name}")"
                           @onchange="e => RecolourCategoryAsync(category, e.Value?.ToString())" />
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategoryAsync(category)">Remove</button>
                </li>
            }
        </ul>

        <div class="field-row mt-2">
            <input @bind="_newCategory" @bind:event="oninput" placeholder="New category" />
            <button class="btn btn-primary" style="flex:0 0 auto;"
                    disabled="@string.IsNullOrWhiteSpace(_newCategory)" @onclick="AddCategoryAsync">Add</button>
        </div>

        @if (_categories.Count >= 8)
        {
            <p class="text-sm muted mt-2 mb-0">
                Eight categories already use the full colour-blind-safe palette. More still work,
                but two of them will share a colour — the amounts beside each one keep it readable.
            </p>
        }
    </section>

    <section class="card">
        <div class="card-header"><h2>People</h2></div>

        <p class="text-sm muted">Everyone who shares the groceries. Each trip records who paid, and the Balance screen works out who owes whom.</p>

        <ul class="list">
            @foreach (var member in _members)
            {
                <li class="list-row">
                    <input class="grow" value="@member.DisplayName" @onchange="e => RenameMemberAsync(member, e.Value?.ToString())" />
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteMemberAsync(member)">Remove</button>
                </li>
            }
        </ul>

        <div class="field-row mt-2">
            <input @bind="_newMember" @bind:event="oninput" placeholder="Name" />
            <button class="btn btn-primary" style="flex:0 0 auto;"
                    disabled="@string.IsNullOrWhiteSpace(_newMember)" @onclick="AddMemberAsync">Add</button>
        </div>
    </section>
}

@code {
  /// <summary>
  /// Palette slots handed out to categories the user adds. Kept in the validated order so the
  /// first eight categories stay distinguishable under colour-vision deficiency.
  /// </summary>
  private static readonly string[] PaletteSlots =
  [
    "#2a78d6", "#eb6834", "#1baf7a", "#eda100",
    "#e87ba4", "#008300", "#4a3aa7", "#e34948",
  ];

  private List<Store> _stores = [];
  private List<Category> _categories = [];
  private List<Member> _members = [];
  private Household? _household;
  private bool _loading = true;

  private string? _newStore;
  private string? _newCategory;
  private string? _newMember;

  protected override async Task OnInitializedAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    _loading = true;
    _household = await Data.GetHouseholdAsync();
    _stores = await Data.GetStoresAsync();
    _categories = await Data.GetCategoriesAsync();
    _members = await Data.GetMembersAsync();
    _loading = false;
  }

  private async Task AddStoreAsync()
  {
    if (string.IsNullOrWhiteSpace(_newStore))
    {
      return;
    }

    await Data.SaveStoreAsync(new Store { Name = _newStore.Trim(), HouseholdId = _household!.Id });
    _newStore = null;
    await LoadAsync();
  }

  private async Task RenameStoreAsync(Store store, string? name)
  {
    if (string.IsNullOrWhiteSpace(name) || name.Trim() == store.Name)
    {
      return;
    }

    store.Name = name.Trim();
    await Data.SaveStoreAsync(store);
  }

  private async Task DeleteStoreAsync(Store store)
  {
    await Data.DeleteStoreAsync(store);
    await LoadAsync();
  }

  private async Task AddCategoryAsync()
  {
    if (string.IsNullOrWhiteSpace(_newCategory))
    {
      return;
    }

    await Data.SaveCategoryAsync(new Category
    {
      Name = _newCategory.Trim(),
      ColorHex = PaletteSlots[_categories.Count % PaletteSlots.Length],
      HouseholdId = _household!.Id,
    });

    _newCategory = null;
    await LoadAsync();
  }

  private async Task RenameCategoryAsync(Category category, string? name)
  {
    if (string.IsNullOrWhiteSpace(name) || name.Trim() == category.Name)
    {
      return;
    }

    category.Name = name.Trim();
    await Data.SaveCategoryAsync(category);
  }

  private async Task RecolourCategoryAsync(Category category, string? colour)
  {
    if (string.IsNullOrWhiteSpace(colour) || colour == category.ColorHex)
    {
      return;
    }

    category.ColorHex = colour;
    await Data.SaveCategoryAsync(category);
    await LoadAsync();
  }

  private async Task DeleteCategoryAsync(Category category)
  {
    await Data.DeleteCategoryAsync(category);
    await LoadAsync();
  }

  private async Task AddMemberAsync()
  {
    if (string.IsNullOrWhiteSpace(_newMember))
    {
      return;
    }

    await Data.SaveMemberAsync(new Member { DisplayName = _newMember.Trim(), HouseholdId = _household!.Id });
    _newMember = null;
    await LoadAsync();
  }

  private async Task RenameMemberAsync(Member member, string? name)
  {
    if (string.IsNullOrWhiteSpace(name) || name.Trim() == member.DisplayName)
    {
      return;
    }

    member.DisplayName = name.Trim();
    await Data.SaveMemberAsync(member);
  }

  private async Task DeleteMemberAsync(Member member)
  {
    await Data.DeleteMemberAsync(member);
    await LoadAsync();
  }
}
