# Copy to .env next to compose.yaml and set the password before the first start.

# Which release to run. "latest" follows the newest release on `podman compose pull`; pin a version
# such as 1.0.0 (or 1.0 for its patch releases) to update only when you choose to.
GROCERYTRACKER_VERSION=latest

POSTGRES_DB=grocerytracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Host port the app is published on: http://<hostname>:8080
WEB_PORT=8080

# HTTPS port, used only once a certificate exists in ./certs. Rootless Podman can't bind ports below
# 1024 by default, so the default stays high.
WEB_TLS_PORT=8443
