# nginx inside the compose stack: serves the published Blazor WebAssembly app and forwards /api to
# the API container. One origin for the browser, so there is no CORS and no preflight on every sync.
#
# This is a *template* (note the .template suffix and ${...} placeholder below): the official
# nginx image's entrypoint runs envsubst on it at container start and writes the result to
# /etc/nginx/conf.d/default.conf. That's what makes the resolver line below work — see the
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS env var set in src/UI/Dockerfile for why this is needed at all.
#
# HTTPS is a second server block in tls-server.conf.template, switched on at container start only
# when a certificate is actually mounted. See deploy/https.md.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;

  # Compose/Podman can recreate the `api` container (a rebuild, an update) without touching this
  # one, handing it a new internal IP. A plain `proxy_pass http://api:5000;` resolves that hostname
  # exactly once, when nginx starts, and then holds onto the stale IP forever — every request after
  # an api restart would hang until this container was restarted too. Declaring a resolver and
  # routing proxy_pass through a variable (in app-common.conf) makes nginx re-resolve `api`
  # instead, on the TTL given here, so it notices a recreated container on its own.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  include /etc/nginx/grocerytracker/app-common.conf;
}
