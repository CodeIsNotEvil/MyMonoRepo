# nginx inside the compose stack: serves the published Blazor WebAssembly app and forwards /api to
# the API container. One origin for the browser, so there is no CORS and no preflight on every sync.
#
# This is a *template* (note the .template suffix and ${...} placeholder below): the official
# nginx image's entrypoint runs envsubst on it at container start and writes the result to
# /etc/nginx/conf.d/default.conf. That's what makes the resolver line below work — see the
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS env var set in src/UI/Dockerfile for why this is needed at all.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;

  # Compose/Podman can recreate the `api` container (a rebuild, an update) without touching this
  # one, handing it a new internal IP. A plain `proxy_pass http://api:5000;` resolves that hostname
  # exactly once, when nginx starts, and then holds onto the stale IP forever — every request after
  # an api restart would hang until this container was restarted too. Declaring a resolver and
  # routing proxy_pass through a variable (below) makes nginx re-resolve `api` instead, on the TTL
  # given here, so it notices a recreated container on its own.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  root /usr/share/nginx/html;
  index index.html;

  # A .NET WebAssembly payload is a few megabytes uncompressed and compresses extremely well, which
  # matters a lot over a home connection to a Pi.
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types text/plain text/css text/javascript application/javascript application/json
             application/wasm application/octet-stream image/svg+xml application/manifest+json;

  # Declaring `types` in a server block *replaces* the MIME table inherited from http{} rather than
  # extending it, so the stock table has to be re-included here (it wraps itself in its own `types`
  # block, hence no nesting) — otherwise index.html, .css and .js all lose their types, fall back to
  # application/octet-stream, and the browser downloads the page instead of rendering it. Two blocks
  # in the same context accumulate, so the extras below just add to it.
  include /etc/nginx/mime.types;
  types {
    application/wasm wasm;
    application/octet-stream dat;
    application/octet-stream blat;
    application/manifest+json webmanifest;
  }

  client_max_body_size 4m;

  location /api/ {
    # A variable rather than a literal is what forces nginx to use the resolver above instead of
    # caching the address it gets on the first request.
    set $api_upstream api:5000;
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # A first sync on a device that has been offline for a while can return a lot of rows.
    proxy_read_timeout 120s;
  }

  location /health {
    set $api_upstream api:5000;
    proxy_pass http://$api_upstream/health;
    access_log off;
  }

  # Framework assets carry a content hash in their name, so they can be cached hard and forever.
  location /_framework/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # These three decide when a client picks up a new version, so they must never be held in a cache.
  location = /service-worker.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files $uri =404;
  }

  location = /service-worker-assets.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  # Client-side routing: unknown paths are app routes, not missing files.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
